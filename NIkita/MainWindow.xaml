<Window x:Class="NikitaMicrosoft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NikitaMicrosoft"
        mc:Ignorable="d"
        Title="Nikita Messenger" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Конвертеры -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:MessageStatusConverter x:Key="MessageStatusConverter"/>
        <local:MessageTypeConverter x:Key="MessageTypeConverter"/>
        <local:InitialsConverter x:Key="InitialsConverter"/>
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <local:OnlineStatusConverter x:Key="OnlineStatusConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:MessageForegroundConverter x:Key="BoolToForegroundConverter"/>

        <!-- Стиль для сообщений -->
        <Style x:Key="MessageBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMyMessage}" Value="True">
                    <Setter Property="Background" Value="#0084FF"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="BorderBrush" Value="#0073E6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для карточки чата -->
        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Стили для кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0084FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0073E6"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0059B3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#999999"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#333333"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для текстового поля -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0084FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для статуса онлайн -->
        <Style x:Key="OnlineStatus" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4CAF50"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- Шаблон для пустого состояния -->
        <ControlTemplate x:Key="EmptyStateTemplate" TargetType="ContentControl">
            <Border Background="White" CornerRadius="10" Padding="40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="120" Height="120" Margin="0,0,0,25">
                        <Grid>
                            <Ellipse Width="80" Height="80" Fill="#F0F0F0"/>
                            <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="{TemplateBinding Content}" 
                               Foreground="#666666" 
                               FontSize="16"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="300"
                               Margin="0,0,0,25"/>
                    <Button Content="{TemplateBinding Tag}" 
                            Style="{StaticResource PrimaryButton}"
                            Width="200"
                            Height="45"
                            Command="{Binding ConnectCommand}"/>
                </StackPanel>
            </Border>
        </ControlTemplate>

        <!-- Стиль для Placeholder текста -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border" 
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Stretch"/>
                                        <TextBlock x:Name="placeholder" 
                                                   Text="{TemplateBinding Tag}"
                                                   Foreground="#999999"
                                                   Margin="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   FontStyle="Italic"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Text" Value=""/>
                                            <Condition Property="IsFocused" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#0084FF"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для панели ввода сообщений -->
        <Style x:Key="MessageInputPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Стиль для заголовка чата -->
        <Style x:Key="ChatHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Height" Value="70"/>
        </Style>

        <!-- Градиент для фона -->
        <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#F0F2F5" Offset="0.5"/>
            <GradientStop Color="#E8EAED" Offset="1"/>
        </LinearGradientBrush>

    </Window.Resources>

    <Grid>
        <!-- Окно подключения -->
        <Grid x:Name="LoginGrid" 
              Background="{StaticResource MainBackground}"
              Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl Template="{StaticResource EmptyStateTemplate}"
                              Content="Подключитесь к серверу для начала общения"
                              Tag="Подключиться к серверу"/>
            </Grid>

            <!-- Подсказка в углу -->
            <Border Background="#0084FF" 
                    CornerRadius="0,0,0,10" 
                    Padding="15,8"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top">
                <TextBlock Text="💡 Используйте 127.0.0.1:8888 для локального сервера" 
                           Foreground="White" 
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- Основной интерфейс мессенджера -->
        <Grid x:Name="MainGrid" 
              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{StaticResource MainBackground}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - Список чатов -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и профиль -->
                    <Border Grid.Row="0" Style="{StaticResource ChatHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Аватар пользователя -->
                            <Border Grid.Column="0" 
                                    Width="48" Height="48" 
                                    CornerRadius="24" 
                                    Background="#0084FF"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">
                                <TextBlock Text="{Binding Username, Converter={StaticResource InitialsConverter}}"
                                           Foreground="White" 
                                           FontSize="18" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Информация о пользователе -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" 
                                           FontWeight="SemiBold" 
                                           FontSize="16"/>
                                <TextBlock Text="онлайн" 
                                           Foreground="#4CAF50" 
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Кнопка меню -->
                            <Button Grid.Column="2" 
                                    Content="⋮"
                                    Style="{StaticResource IconButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Поле поиска -->
                    <Border Grid.Row="1" 
                            Background="White" 
                            Padding="15,10">
                        <Border Background="#F5F5F5" 
                                CornerRadius="25" 
                                Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="🔍" 
                                           FontSize="16"
                                           Margin="15,0"
                                           VerticalAlignment="Center"
                                           Foreground="#666666"/>

                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PlaceholderTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Tag="Поиск чатов..."
                                         Padding="0,10"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2" 
                                        Content="✕"
                                        Style="{StaticResource IconButton}"
                                        Width="36" Height="36"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding SearchText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Список чатов -->
                    <ScrollViewer Grid.Row="2" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,2,0">
                        <ItemsControl ItemsSource="{Binding Chats}"
                                      BorderThickness="0"
                                      Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" 
                                            Background="Transparent"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="ChatItem_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Setter Property="BorderBrush" Value="#0084FF"/>
                                                        <Setter Property="BorderThickness" Value="0,0,3,0"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Аватар чата -->
                                            <Border Grid.Column="0" 
                                                    Width="52" Height="52" 
                                                    CornerRadius="26"
                                                    Background="#0084FF" 
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                           Foreground="White" 
                                                           FontSize="20" 
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Информация о чате -->
                                            <StackPanel Grid.Column="1" 
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="14.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="180"/>
                                                    <Ellipse Style="{StaticResource OnlineStatus}" 
                                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastMessage}" 
                                                           Foreground="#666666" 
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Время и счетчик -->
                                            <StackPanel Grid.Column="2" 
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding LastMessageTimeString}" 
                                                           Foreground="#999999" 
                                                           FontSize="11.5"/>
                                                <Border Width="22" Height="22" 
                                                        CornerRadius="11" 
                                                        Background="#0084FF"
                                                        Margin="0,5,0,0"
                                                        Visibility="{Binding UnreadCount, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding UnreadCount}" 
                                                               Foreground="White" 
                                                               FontSize="11" 
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Кнопка нового чата -->
                    <Border Grid.Row="3" 
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="0,1,0,0"
                            Padding="15">
                        <Button Content="+ Новый чат" 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewChatCommand}"
                                HorizontalAlignment="Stretch"
                                Height="45"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Центральная панель - Чат -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок чата -->
                <Border Grid.Row="0" 
                        Style="{StaticResource ChatHeaderStyle}"
                        Background="White"
                        Visibility="{Binding IsChatSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Информация о собеседнике/чате -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <Border Width="44" Height="44" 
                                    CornerRadius="22" 
                                    Background="#0084FF" 
                                    Margin="0,0,15,0">
                                <TextBlock Text="{Binding SelectedChat.Name, Converter={StaticResource InitialsConverter}}"
                                           Foreground="White" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedChat.Name}" 
                                           FontWeight="SemiBold" 
                                           FontSize="16.5"/>
                                <TextBlock Text="{Binding SelectedChat.IsOnline, Converter={StaticResource OnlineStatusConverter}}"
                                           Foreground="#4CAF50" 
                                           FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Действия с чатом -->
                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="📞" 
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Начать звонок"/>
                            <Button Content="⋮" 
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Дополнительные действия"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Сообщения -->
                <Border Grid.Row="1" 
                        Background="{StaticResource MainBackground}"
                        Visibility="{Binding IsChatSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <ScrollViewer x:Name="MessagesScrollViewer" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="25,15">

                        <ItemsControl ItemsSource="{Binding SelectedChat.Messages}"
                                      BorderThickness="0"
                                      Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <!-- Дата-разделитель -->
                                        <Border Visibility="{Binding ShowDateSeparator, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="#E3F2FD" 
                                                CornerRadius="6" 
                                                Padding="12,6" 
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,15"
                                                BorderThickness="1"
                                                BorderBrush="#D1E9FF">
                                            <TextBlock Text="{Binding DateString}" 
                                                       Foreground="#0084FF" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Сообщение -->
                                        <Border Style="{StaticResource MessageBorderStyle}">
                                            <StackPanel>
                                                <!-- Текстовое сообщение -->
                                                <TextBlock Text="{Binding Content}" 
                                                           Foreground="{Binding IsMyMessage, Converter={StaticResource BoolToForegroundConverter}}"
                                                           TextWrapping="Wrap"
                                                           FontSize="14.5"
                                                           Visibility="{Binding Type, Converter={StaticResource MessageTypeConverter}, ConverterParameter=Text}"/>

                                                <!-- Файл -->
                                                <Border Visibility="{Binding Type, Converter={StaticResource MessageTypeConverter}, ConverterParameter=File}"
                                                        CornerRadius="10" 
                                                        Padding="14" 
                                                        Margin="0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📎" 
                                                                       FontSize="22" 
                                                                       Margin="0,0,14,0"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Content}" 
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           FontSize="14"/>
                                                                <TextBlock Text="{Binding FilePath, Converter={StaticResource FileSizeConverter}}" 
                                                                           Foreground="{Binding IsMyMessage, Converter={StaticResource BoolToForegroundConverter}}"
                                                                           FontSize="12"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Content="Скачать" 
                                                                Style="{StaticResource PrimaryButton}"
                                                                Margin="0,14,0,0" 
                                                                Padding="10,8"
                                                                FontSize="13"
                                                                Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Изображение -->
                                                <Border Visibility="{Binding Type, Converter={StaticResource MessageTypeConverter}, ConverterParameter=Image}"
                                                        Background="White" 
                                                        CornerRadius="10" 
                                                        Padding="10" 
                                                        Margin="0,8"
                                                        BorderThickness="1"
                                                        BorderBrush="#E0E0E0">
                                                    <StackPanel>
                                                        <Border CornerRadius="8" 
                                                                Background="#F5F5F5"
                                                                Padding="10">
                                                            <Image Source="{Binding FilePath}" 
                                                                   MaxWidth="320" 
                                                                   MaxHeight="320"
                                                                   Stretch="Uniform"/>
                                                        </Border>
                                                        <Button Content="Скачать" 
                                                                Style="{StaticResource PrimaryButton}"
                                                                Margin="0,10,0,0" 
                                                                Padding="10,8"
                                                                FontSize="13"
                                                                Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Время и статус -->
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Right" 
                                                            Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding TimeString}" 
                                                               Foreground="{Binding IsMyMessage, Converter={StaticResource BoolToForegroundConverter}}"
                                                               FontSize="11.5" 
                                                               Opacity="0.8" 
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource MessageStatusConverter}}"
                                                               Foreground="{Binding IsMyMessage, Converter={StaticResource BoolToForegroundConverter}}"
                                                               FontSize="11.5" 
                                                               Opacity="0.8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Индикатор "печатает..." -->
                <Border Grid.Row="2" 
                        Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="0,1,0,0"
                        Height="35"
                        Visibility="{Binding SelectedChat.IsTyping, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedChat.TypingStatus}" 
                               Foreground="#666666" 
                               FontSize="13" 
                               FontStyle="Italic"
                               Margin="25,0"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Панель ввода -->
                <Border Grid.Row="2" 
                        Style="{StaticResource MessageInputPanel}"
                        Visibility="{Binding IsChatSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кнопки вложений -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <Button x:Name="AttachFileButton"
                                    Content="📎"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding AttachFileCommand}"
                                    ToolTip="Прикрепить файл"
                                    FontSize="20"/>
                            <Button x:Name="AttachImageButton"
                                    Content="📷"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding AttachImageCommand}"
                                    ToolTip="Прикрепить изображение"
                                    FontSize="20"/>
                        </StackPanel>

                        <!-- Поле ввода -->
                        <Border Grid.Column="1" 
                                Background="#F5F5F5" 
                                CornerRadius="25" 
                                Margin="12,0"
                                Padding="3">
                            <TextBox x:Name="MessageTextBox" 
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlaceholderTextBox}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="120"
                                     Tag="Введите сообщение..."
                                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <!-- Кнопка отправки -->
                        <Button Grid.Column="2" 
                                x:Name="SendButton"
                                Content="➤"
                                Style="{StaticResource PrimaryButton}"
                                Width="52" 
                                Height="52"
                                FontSize="18"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding CanSendMessage}"/>
                    </Grid>
                </Border>

                <!-- Сообщение о выборе чата -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{StaticResource MainBackground}"
                        Visibility="{Binding IsChatSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="180" Height="180" Margin="0,0,0,30">
                            <Grid>
                                <Ellipse Width="120" Height="120" Fill="#F0F0F0"/>
                                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                      Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Выберите чат для начала общения" 
                                   Foreground="#666666" 
                                   FontSize="17"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="или создайте новый" 
                                   Foreground="#999999" 
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Правая панель - Онлайн пользователи -->
            <Border Grid.Column="2" 
                    Background="White" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" Style="{StaticResource ChatHeaderStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="22" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Онлайн пользователи" 
                                           FontWeight="SemiBold" 
                                           FontSize="16.5"/>
                                <TextBlock Text="({Binding OnlineUsersCount})" 
                                           Foreground="#666666" 
                                           FontSize="13.5"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Список онлайн пользователей -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="15,10">

                        <ItemsControl ItemsSource="{Binding OnlineUsers}"
                                      BorderThickness="0"
                                      Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" 
                                            Background="Transparent"
                                            Cursor="Hand"
                                            CornerRadius="8"
                                            MouseLeftButtonUp="UserItem_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Аватар пользователя -->
                                            <Border Grid.Column="0" 
                                                    Width="42" Height="42" 
                                                    CornerRadius="21"
                                                    Background="#0084FF" 
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Username, Converter={StaticResource InitialsConverter}}"
                                                           Foreground="White" 
                                                           FontSize="14" 
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Имя пользователя -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="14.5"/>
                                                <TextBlock Text="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}"
                                                           Foreground="#4CAF50" 
                                                           FontSize="12.5"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Кнопка сообщения -->
                                            <Button Grid.Column="2" 
                                                    Content="💬"
                                                    Style="{StaticResource IconButton}"
                                                    Width="36" Height="36"
                                                    FontSize="16"
                                                    Command="{Binding DataContext.StartPrivateChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Написать сообщение"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>