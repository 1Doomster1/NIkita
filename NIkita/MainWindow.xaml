<Window x:Class="NIkita.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:NIkita"
        mc:Ignorable="d"
        Title="Nikita Messenger" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MyMessageBorder" TargetType="Border">
            <Setter Property="Background" Value="#0084FF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>

        <Style x:Key="OtherMessageBorder" TargetType="Border">
            <Setter Property="Background" Value="Wheat"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>

        <local:MessageStyleConverter x:Key="MessageStyleConverter">
            <local:MessageStyleConverter.MyMessageStyle>
                <StaticResource ResourceKey="MyMessageBorder"/>
            </local:MessageStyleConverter.MyMessageStyle>
            <local:MessageStyleConverter.OtherMessageStyle>
                <StaticResource ResourceKey="OtherMessageBorder"/>
            </local:MessageStyleConverter.OtherMessageStyle>
        </local:MessageStyleConverter>

        <Style x:Key="ChatItemBorder" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0084FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Конвертеры через Binding -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - Список чатов -->
        <Grid Grid.Column="0" Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15">
                    <Ellipse Width="40" Height="40" Fill="#0084FF"/>
                    <TextBlock Text="Nikita Messenger" FontSize="18" FontWeight="SemiBold" 
                               Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Список чатов -->
            <ListBox Grid.Row="1" x:Name="ChatsListBox" 
                     ItemsSource="{Binding Chats}" 
                     SelectedItem="{Binding SelectedChat}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ChatItemBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Аватар -->
                                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25"
                                        Background="#0084FF" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Initials}"
                                               Foreground="White" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Информация о чате -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" 
                                                   FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="5,0,0,0"
                                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastMessage}" Foreground="#666" 
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Время и счетчик -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastMessageTimeString}" Foreground="#999" 
                                               FontSize="11"/>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#0084FF"
                                            Margin="0,5,0,0"
                                            Visibility="{Binding HasUnreadMessages, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" 
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Кнопка нового чата -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Button Content="Новый чат" 
                        Style="{StaticResource ActionButton}"
                        Margin="10" HorizontalAlignment="Stretch"
                        Command="{Binding NewChatCommand}"/>
            </Border>
        </Grid>

        <!-- Правая панель - Сообщения -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок чата -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsChatSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#0084FF" Margin="0,0,10,0">
                            <TextBlock Text="{Binding SelectedChat.Initials}"
                                       Foreground="White" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedChat.Name}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding SelectedChat.OnlineStatus}"
                                       Foreground="#4CAF50" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Сообщения -->
            <Border Grid.Row="1" Background="#F0F0F0">
                <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedChat.Messages}" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Border Style="{Binding IsMyMessage, Converter={StaticResource MessageStyleConverter}}">
                                        <StackPanel>
                                            <!-- Текстовое сообщение -->
                                            <TextBlock Text="{Binding Content}" 
                                                       Foreground="{Binding MessageForeground}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsTextType, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- Файл -->
                                            <Border Visibility="{Binding IsFileType, Converter={StaticResource BoolToVisibility}}"
                                                    Background="White" CornerRadius="10" Padding="10" Margin="0,5">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📎" FontSize="20" Margin="0,0,10,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Content}" 
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding FileSize}" 
                                                                       Foreground="#666" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Content="Скачать" 
                                                            Style="{StaticResource ActionButton}"
                                                            Margin="0,10,0,0" 
                                                            Tag="{Binding}" 
                                                            Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Изображение -->
                                            <Border Visibility="{Binding IsImageType, Converter={StaticResource BoolToVisibility}}"
                                                    Background="White" CornerRadius="10" Padding="10" Margin="0,5">
                                                <StackPanel>
                                                    <Image Source="{Binding ImagePath}" 
                                                           MaxWidth="300" MaxHeight="300"
                                                           Stretch="Uniform"/>
                                                    <Button Content="Скачать" 
                                                            Style="{StaticResource ActionButton}"
                                                            Margin="0,10,0,0" 
                                                            Tag="{Binding}" 
                                                            Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Время и статус -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                                                        Margin="0,5,0,0">
                                                <TextBlock Text="{Binding TimeString}" 
                                                           Foreground="{Binding MessageForeground}"
                                                           FontSize="10" Opacity="0.8" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding StatusIcon}"
                                                           Foreground="{Binding MessageForeground}"
                                                           FontSize="10" Opacity="0.8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Панель ввода -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsChatSelected, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AttachFileButton" Content="📎"
                                Style="{StaticResource IconButton}"
                                Command="{Binding AttachFileCommand}"/>
                        <Button x:Name="AttachImageButton" Content="📷"
                                Style="{StaticResource IconButton}"
                                Command="{Binding AttachImageCommand}"/>
                    </StackPanel>

                    <!-- Поле ввода -->
                    <TextBox Grid.Column="1" x:Name="MessageTextBox" 
                             Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="#F0F0F0" 
                             FontSize="14" Padding="15,10" AcceptsReturn="True" 
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             MaxHeight="100" 
                             Margin="10,0"/>

                    <!-- Кнопка отправки -->
                    <Button Grid.Column="2" Content="➤"
                            Style="{StaticResource ActionButton}"
                            Width="50" Height="50"
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding CanSendMessage}"/>
                </Grid>
            </Border>

            <!-- Пустой экран при отсутствии выбранного чата -->
            <Border Grid.Row="1" Grid.RowSpan="2" Background="#F0F0F0"
                    Visibility="{Binding IsNoChatSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Выберите чат для начала общения" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="18" Foreground="#666"/>
            </Border>
        </Grid>
    </Grid>
</Window>