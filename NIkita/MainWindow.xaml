<Window x:Class="NikitaMessenger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nikita Messenger" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Встроенный конвертер BooleanToVisibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Стиль для сообщений -->
        <Style x:Key="MessageBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMyMessage}" Value="True">
                    <Setter Property="Background" Value="#0084FF"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="BorderBrush" Value="#0073E6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0084FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0073E6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0059B3"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#999999"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#333333"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для текстового поля -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0084FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для прозрачного TextBox (используется для поиска и ввода сообщений) -->
        <Style x:Key="TransparentTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Foreground" Value="#999999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для статуса онлайн -->
        <Style x:Key="OnlineStatus" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4CAF50"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- Стиль для панели ввода сообщений -->
        <Style x:Key="MessageInputPanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Стиль для заголовка чата -->
        <Style x:Key="ChatHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Height" Value="70"/>
        </Style>

        <!-- Градиент для фона -->
        <LinearGradientBrush x:Key="MainBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#F0F2F5" Offset="0.5"/>
            <GradientStop Color="#E8EAED" Offset="1"/>
        </LinearGradientBrush>

    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - Список чатов -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и профиль -->
                    <Border Grid.Row="0" Style="{StaticResource ChatHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Аватар пользователя -->
                            <Button Grid.Column="0" 
                                    x:Name="AvatarButton"
                                    Width="48" Height="48" 
                                    Padding="0"
                                    Margin="0,0,15,0"
                                    ToolTip="Сменить аватар"
                                    Click="AvatarButton_Click">
                                <Border CornerRadius="24" 
                                        Background="#0084FF">
                                    <Grid>
                                        <TextBlock Text="U1"
                                                   Foreground="White" 
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Информация о пользователе -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Пользователь" 
                                           FontWeight="SemiBold" 
                                           FontSize="16"/>
                                <TextBlock Text="онлайн" 
                                           Foreground="#4CAF50" 
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Кнопка подключения -->
                            <Button Grid.Column="2" 
                                    x:Name="ConnectButton"
                                    Content="🔌"
                                    Style="{StaticResource IconButton}"
                                    VerticalAlignment="Center"
                                    ToolTip="Подключиться к серверу"
                                    Click="ConnectButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Поле поиска -->
                    <Border Grid.Row="1" 
                            Background="White" 
                            Padding="15,10">
                        <Border Background="#F5F5F5" 
                                CornerRadius="25" 
                                Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="🔍" 
                                           FontSize="16"
                                           Margin="15,0"
                                           VerticalAlignment="Center"
                                           Foreground="#666666"/>

                                <!-- ИСПРАВЛЕНО: убрано дублирование свойства Style -->
                                <TextBox Grid.Column="1" 
                                         x:Name="SearchTextBox"
                                         Style="{StaticResource TransparentTextBox}"
                                         Text=""
                                         Padding="0,10"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchTextBox_TextChanged"/>

                                <Button Grid.Column="2" 
                                        x:Name="ClearSearchButton"
                                        Content="✕"
                                        Style="{StaticResource IconButton}"
                                        Width="36" Height="36"
                                        Click="ClearSearchButton_Click"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Список чатов -->
                    <ScrollViewer Grid.Row="2" 
                                  x:Name="ChatsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,2,0">
                        <StackPanel x:Name="ChatsPanel">
                            <!-- Чаты будут добавляться динамически -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопка нового чата -->
                    <Border Grid.Row="3" 
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="0,1,0,0"
                            Padding="15">
                        <Button x:Name="NewChatButton"
                                Content="+ Новый чат" 
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Height="45"
                                Click="NewChatButton_Click"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Центральная панель - Чат -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок чата -->
                <Border Grid.Row="0" 
                        x:Name="ChatHeader"
                        Style="{StaticResource ChatHeaderStyle}"
                        Background="White"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Информация о собеседнике/чате -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <Border x:Name="ChatAvatarBorder"
                                    Width="44" Height="44" 
                                    CornerRadius="22" 
                                    Background="#0084FF" 
                                    Margin="0,0,15,0">
                                <TextBlock x:Name="ChatAvatarText"
                                           Text="??"
                                           Foreground="White" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="ChatNameText"
                                           Text="Имя чата" 
                                           FontWeight="SemiBold" 
                                           FontSize="16.5"/>
                                <TextBlock x:Name="ChatStatusText"
                                           Text="онлайн" 
                                           Foreground="#4CAF50" 
                                           FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Действия с чатом -->
                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="📞" 
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Начать звонок"
                                    Click="CallButton_Click"/>
                            <Button Content="⋮" 
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Дополнительные действия"
                                    Click="MoreButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Сообщения -->
                <Border Grid.Row="1" 
                        x:Name="MessagesBorder"
                        Background="{StaticResource MainBackground}"
                        Visibility="Collapsed">

                    <ScrollViewer x:Name="MessagesScrollViewer" 
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="25,15">
                        <StackPanel x:Name="MessagesPanel">
                            <!-- Сообщения будут добавляться динамически -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Панель ввода -->
                <Border Grid.Row="2" 
                        x:Name="MessageInputBorder"
                        Style="{StaticResource MessageInputPanel}"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кнопки вложений -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <Button x:Name="AttachFileButton"
                                    Content="📎"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Прикрепить файл"
                                    FontSize="20"
                                    Click="AttachFileButton_Click"/>
                            <Button x:Name="AttachImageButton"
                                    Content="📷"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Прикрепить изображение"
                                    FontSize="20"
                                    Click="AttachImageButton_Click"/>
                        </StackPanel>

                        <!-- Поле ввода -->
                        <Border Grid.Column="1" 
                                Background="#F5F5F5" 
                                CornerRadius="25" 
                                Margin="12,0"
                                Padding="3">
                            <!-- ИСПРАВЛЕНО: убрано дублирование свойства Style -->
                            <TextBox x:Name="MessageTextBox" 
                                     Style="{StaticResource TransparentTextBox}"
                                     MaxHeight="120"
                                     Text=""
                                     VerticalContentAlignment="Center"
                                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                                     GotFocus="MessageTextBox_GotFocus"
                                     LostFocus="MessageTextBox_LostFocus"/>
                        </Border>

                        <!-- Кнопка отправки -->
                        <Button Grid.Column="2" 
                                x:Name="SendButton"
                                Content="➤"
                                Style="{StaticResource PrimaryButton}"
                                Width="52" 
                                Height="52"
                                FontSize="18"
                                Click="SendButton_Click"/>
                    </Grid>
                </Border>

                <!-- Сообщение о выборе чата -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        x:Name="NoChatSelectedBorder"
                        Background="{StaticResource MainBackground}">

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="180" Height="180" Margin="0,0,0,30">
                            <Grid>
                                <Ellipse Width="120" Height="120" Fill="#F0F0F0"/>
                                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                      Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="Выберите чат для начала общения" 
                                   Foreground="#666666" 
                                   FontSize="17"
                                   TextAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="или создайте новый" 
                                   Foreground="#999999" 
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Правая панель - Онлайн пользователи -->
            <Border Grid.Column="2" 
                    Background="White" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" Style="{StaticResource ChatHeaderStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="22" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Онлайн пользователи" 
                                           FontWeight="SemiBold" 
                                           FontSize="16.5"/>
                                <TextBlock x:Name="OnlineUsersCountText"
                                           Text="(0)" 
                                           Foreground="#666666" 
                                           FontSize="13.5"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Список онлайн пользователей -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="15,10">
                        <StackPanel x:Name="OnlineUsersPanel">
                            <!-- Пользователи будут добавляться динамически -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>