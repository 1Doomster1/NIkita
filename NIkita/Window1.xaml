<Window x:Class="NIkita.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый чат" Height="150" Width="300"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock Text="Введите имя собеседника:" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Height="30" Margin="0,0,0,20"/>
        <Button Content="Создать" Height="30" Click="Button_Click"/>
    </StackPanel>
</Window>
